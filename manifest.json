{
  "name": "MP4 to MP3 Converter",
  "short_name": "MP4→MP3",
  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        { "name": "file", "accept": ["video/*", "audio/*"] }
      ]
    }
  }
}
